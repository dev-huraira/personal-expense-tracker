
# PostgreSQL configuration
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=expense_tracker

# Application database connection
DATABASE_URL=postgresql+psycopg://expense_user:your_postgres_password@localhost:5432/expense_tracker

# JWT authentication
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Test database
TEST_DATABASE_URL=postgresql+psycopg://test_user:test_password@localhost:5432/expense_tracker_test
